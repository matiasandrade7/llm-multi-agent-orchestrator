# Plantilla de variables de entorno. `python main.py simular` y `pytest` no las necesitan.

# --- LLM (obligatoria para consultas reales) -----------------------------------
# Proveedor: gemini (por defecto) | openai | anthropic
LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Opcional: fuerza un modelo concreto (si no, se usa el default del proveedor, ver src/config.py)
# LLM_MODEL=

# --- Pinecone (obligatoria para consultas reales) ------------------------------
# https://app.pinecone.io -> API Keys. El índice es el creado en la pre-entrega 4.
PINECONE_API_KEY=
INDEX_NAME=codigo-tributario-rag
NAMESPACE=codigo-tributario
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Límites del grafo (opcionales; valores por defecto entre paréntesis) ------
# MAX_STEPS=6                    # decisiones máximas del supervisor por consulta
# MAX_CALLS_PER_AGENT=2          # veces máximas que se llama a un mismo especialista
# RECURSION_LIMIT=30             # red de seguridad final de LangGraph
# SPECIALIST_RECURSION_LIMIT=12  # idem, dentro de cada especialista (ciclo ReAct)
# MAX_EVIDENCE_CHARS=6000        # evidencia máxima que se le pasa al analista y a la síntesis
# LLM_RETRIES=3                  # reintentos ante fallas transitorias del LLM
# RAG_TOP_K=5                    # artículos/chunks recuperados por búsqueda
